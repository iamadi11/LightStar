{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company/schemas/task.schema.json",
  "title": "CompanyTask",
  "type": "object",
  "required": ["id", "title", "status", "category", "evidence", "priority_rationale", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^T-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 8 },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "in_progress", "blocked", "review", "done", "rejected", "deferred"]
    },
    "category": {
      "type": "string",
      "enum": ["product", "bug", "security", "reliability", "debt", "docs", "dx", "research", "test", "process"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["repo", "test", "ci", "doc", "strategy", "research", "hypothesis"]
          },
          "ref": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "priority_rationale": { "type": "string", "minLength": 20 },
    "owner_role": { "type": "string" },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "validation_plan": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "blocked_reason": { "type": "string" },
    "completion_evidence": { "type": "array", "items": { "type": "string" } }
  }
}
